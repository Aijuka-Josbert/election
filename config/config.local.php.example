 *
 *   cp config/config.local.php.example config/config.local.php
 *
 * You can also skip this file entirely and set the equivalent
 * DB_HOST / DB_NAME / DB_USER / DB_PASS / LIVE_DB_* / GOOGLE_CLIENT_ID /
 * GOOGLE_CLIENT_SECRET environment variables instead — config.php reads
 * both.
 */

